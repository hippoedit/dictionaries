<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.hippoedit.com/xml/package-info">
<package-info xmlns="http://www.hippoedit.com/xml/package-info" xmlns:smf="http://www.hippoedit.com/">
	<id>dict-be-be</id>
	<name>Belarusian</name>	
	<version>0.1.2.1</version>
	<description>Беларускі слоўнік для праверкі правапісу</description>
	<author>Vital Khilko</author>
	<email>vk@mova.org</email>
	<homepage>http://wiki.hippoedit.com/dictionary/be-be</homepage>
	<locale>be_BE</locale>
	<memo></memo>

	<!-- Common Install actions -->
	<install>
		<!-- Read me -->
		<readme type="inline">This will install Belarusian spell-checking dictionary for HippoEDIT.</readme>

		<require-file name="be_BE.aff" destination="%{dictionaries}%/be_BE.aff" />
		<require-file name="be_BE.dic" destination="%{dictionaries}%/be_BE.dic" />
		<require-file name="README_be_BE.txt" destination="%{dictionaries}%/README_be_BE.txt" />
	</install>

	<!-- Uninstall actions -->
	<uninstall>
		<!-- Read me -->
		<readme type="inline">This will uninstall Belarusian spell-checking dictionary for HippoEDIT.</readme>

		<!-- Source files -->
		<remove-file name="%{dictionaries}%/be_BE.aff" />
		<remove-file name="%{dictionaries}%/be_BE.dic" />
		<remove-file name="%{dictionaries}%/README_be_BE.txt" />

	</uninstall>

</package-info>