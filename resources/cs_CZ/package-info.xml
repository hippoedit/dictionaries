<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.hippoedit.com/xml/package-info">
<package-info xmlns="http://www.hippoedit.com/xml/package-info" xmlns:smf="http://www.hippoedit.com/">
	<id>dict-cs-cz</id>
	<name>Czech</name>	
	<version>1.0.0.0</version>
	<description>Czech dictionary</description>
	<author>Petr Kolar</author>
	<email>danohnesorg@openoffice.org</email>
	<homepage>http://wiki.hippoedit.com/dictionary/cs-cz</homepage>
	<locale>cs_CZ</locale>
	<memo></memo>

	<!-- Common Install actions -->
	<install>
		<!-- Read me -->
		<readme type="inline">This will install Czech dictionary for HippoEDIT.</readme>

		<require-file name="cs_CZ.aff" destination="%{dictionaries}%/cs_CZ.aff" />
		<require-file name="cs_CZ.dic" destination="%{dictionaries}%/cs_CZ.dic" />
		<require-file name="README_cs_CZ.txt" destination="%{dictionaries}%/README_cs_CZ.txt" />

	</install>

	<!-- Uninstall actions -->
	<uninstall>
		<!-- Read me -->
		<readme type="inline">This will uninstall Czech dictionary for HippoEDIT.</readme>

		<!-- Source files -->
		<remove-file name="%{dictionaries}%/cs_CZ.aff" />
		<remove-file name="%{dictionaries}%/cs_CZ.dic" />
		<remove-file name="%{dictionaries}%/README_cs_CZ.txt" />

	</uninstall>

</package-info>