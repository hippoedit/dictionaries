<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.hippoedit.com/xml/package-info">
<package-info xmlns="http://www.hippoedit.com/xml/package-info" xmlns:smf="http://www.hippoedit.com/">
	<id>dict-id-id</id>
	<name>Indonesian</name>	
	<version>1.1.1</version>
	<description>Kamus Pengecek Ejaan Bahasa Indonesia</description>
	<author>Romi Hardiyanto, Benitius Brevoort</author>
	<email>supportbox@hippoedit.com</email>
	<homepage>http://wiki.hippoedit.com/dictionary/id-id</homepage>
	<locale>id_ID</locale>
	<memo></memo>

	<!-- Common Install actions -->
	<install>
		<!-- Read me -->
		<readme type="inline">This will install Indonesian dictionary for HippoEDIT.</readme>

		<require-file name="id_ID.aff" destination="%{dictionaries}%/id_ID.aff" />
		<require-file name="id_ID.dic" destination="%{dictionaries}%/id_ID.dic" />
		<require-file name="README_id_ID.txt" destination="%{dictionaries}%/README_id_ID.txt" />

	</install>

	<!-- Uninstall actions -->
	<uninstall>
		<!-- Read me -->
		<readme type="inline">This will uninstall Indonesian dictionary for HippoEDIT.</readme>

		<!-- Source files -->
		<remove-file name="%{dictionaries}%/id_ID.aff" />
		<remove-file name="%{dictionaries}%/id_ID.dic" />
		<remove-file name="%{dictionaries}%/README_id_ID.txt" />

	</uninstall>

</package-info>