<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.hippoedit.com/xml/package-info">
<package-info xmlns="http://www.hippoedit.com/xml/package-info" xmlns:smf="http://www.hippoedit.com/">
	<id>dict-en-ca</id>
	<name>English (Canadian)</name>	
	<version>1.0.0.0</version>
	<description>English (Canadian) dictionary</description>
	<author>László Németh</author>
	<email>nemeth@openoffice.org</email>
	<homepage>http://wiki.hippoedit.com/dictionary/english-ca</homepage>
	<locale>en_CA</locale>
	<memo></memo>

	<!-- Common Install actions -->
	<install>
		<!-- Read me -->
		<readme type="inline">This will install English (Canadian) dictionary for HippoEDIT.</readme>

		<require-file name="en_CA.aff" destination="%{dictionaries}%/en_CA.aff" />
		<require-file name="en_CA.dic" destination="%{dictionaries}%/en_CA.dic" />
		<require-file name="README_en_CA.txt" destination="%{dictionaries}%/README_en_CA.txt" />

	</install>

	<!-- Uninstall actions -->
	<uninstall>
		<!-- Read me -->
		<readme type="inline">This will uninstall English (Canadian) dictionary for HippoEDIT.</readme>

		<!-- Source files -->
		<remove-file name="%{dictionaries}%/en_CA.aff" />
		<remove-file name="%{dictionaries}%/en_CA.dic" />
		<remove-file name="%{dictionaries}%/README_en_CA.txt" />

	</uninstall>

</package-info>