<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.hippoedit.com/xml/package-info">
<package-info xmlns="http://www.hippoedit.com/xml/package-info" xmlns:smf="http://www.hippoedit.com/">
	<id>dict-en-gb</id>
	<name>English (United Kingdom)</name>	
	<version>2.64</version>
	<description>British English Dictionary</description>
	<author>Marco Pinto</author>
	<email>marcoagpinto@mail.telepac.pt</email>
	<homepage>http://wiki.hippoedit.com/dictionary/english-gb</homepage>
	<locale>en_GB</locale>
	<memo></memo>

	<!-- Common Install actions -->
	<install>
		<!-- Read me -->
		<readme type="inline">This will install English (United Kingdom) dictionary for HippoEDIT.</readme>

		<require-file name="en_GB.aff" destination="%{dictionaries}%/en_GB.aff" />
		<require-file name="en_GB.dic" destination="%{dictionaries}%/en_GB.dic" />
		<require-file name="README_en_GB.txt" destination="%{dictionaries}%/README_en_GB.txt" />

	</install>

	<!-- Uninstall actions -->
	<uninstall>
		<!-- Read me -->
		<readme type="inline">This will uninstall English (United Kingdom) dictionary for HippoEDIT.</readme>

		<!-- Source files -->
		<remove-file name="%{dictionaries}%/en_GB.aff" />
		<remove-file name="%{dictionaries}%/en_GB.dic" />
		<remove-file name="%{dictionaries}%/README_en_GB.txt" />

	</uninstall>

</package-info>