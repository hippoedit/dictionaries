<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.hippoedit.com/xml/package-info">
<package-info xmlns="http://www.hippoedit.com/xml/package-info" xmlns:smf="http://www.hippoedit.com/">
	<id>dict-el-gr</id>
	<name>Greek</name>	
	<version>0.8.5.1</version>
	<description>Greek Spelling dictionary</description>
	<author>Kostas Papadimas</author>
	<email>supportbox@hippoedit.com</email>
	<homepage>http://wiki.hippoedit.com/dictionary/el-gr</homepage>
	<locale>el_GR</locale>
	<memo></memo>

	<!-- Common Install actions -->
	<install>
		<!-- Read me -->
		<readme type="inline">This will install Greek Spelling dictionary for HippoEDIT.</readme>

		<require-file name="el_GR.aff" destination="%{dictionaries}%/el_GR.aff" />
		<require-file name="el_GR.dic" destination="%{dictionaries}%/el_GR.dic" />
		<require-file name="README_el_GR.txt" destination="%{dictionaries}%/README_el_GR.txt" />

	</install>

	<!-- Uninstall actions -->
	<uninstall>
		<!-- Read me -->
		<readme type="inline">This will uninstall Greek Spelling dictionary for HippoEDIT.</readme>

		<!-- Source files -->
		<remove-file name="%{dictionaries}%/el_GR.aff" />
		<remove-file name="%{dictionaries}%/el_GR.dic" />
		<remove-file name="%{dictionaries}%/README_el_GR.txt" />

	</uninstall>

</package-info>